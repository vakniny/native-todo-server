MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/native-todo
PORT=3000

# Comma-separated browser origins allowed to call the API. Leave empty for
# mobile-only deploys; the native app sends no Origin header.
ALLOWED_ORIGINS=

# Set to the number of proxy hops in front of the app (1 behind a single load
# balancer). Required for rate limiting to see real client IPs.
TRUST_PROXY=
